# ==========================================
# PortaChar Dashboard - Git Ignore Rules
# ==========================================

# Database & SQLite files (auto-generated at runtime)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
auth.db

# Logs and runtime traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.Rhistory

# Environment variables & local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Dependency directories
node_modules/
jspm_packages/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env/
env/
venv/
ENV/
env.bak/
venv.bak/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary & scratch files
tmp/
temp/
scratch/
*.tmp
